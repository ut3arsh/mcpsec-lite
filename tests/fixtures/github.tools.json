[
  {
    "name": "get_issue",
    "description": "Get details of a specific issue in a GitHub repository.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "description": "Repository owner (username or organization)"
        },
        "repo": {
          "type": "string",
          "description": "Repository name"
        },
        "issue_number": {
          "type": "integer",
          "description": "Issue number"
        }
      },
      "required": [
        "owner",
        "repo",
        "issue_number"
      ]
    }
  },
