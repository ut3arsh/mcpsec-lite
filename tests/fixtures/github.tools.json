  {
    "name": "list_issues",
    "description": "List issues in a GitHub repository with filters.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "description": "Repository owner"
        },
        "repo": {
          "type": "string",
          "description": "Repository name"
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "closed",
            "all"
          ]
        },
        "labels": {
          "type": "string",
          "description": "Comma-separated list of label names"
        },
        "sort": {
          "type": "string",
          "enum": [
            "created",
            "updated",
            "comments"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "since": {
          "type": "string",
          "description": "ISO 8601 timestamp"
        },
        "page": {
          "type": "integer"
        },
        "per_page": {
          "type": "integer"
        }
      },
      "required": [
        "owner",
        "repo"
      ]
    }
  },
